# OpenIDEA in the browser: docker build -f Dockerfile.web -t openidea-web .
FROM node:22-bookworm AS frontend
WORKDIR /src
RUN corepack enable
COPY . .
RUN pnpm install --no-frozen-lockfile && pnpm build:web

FROM rust:1.97-bookworm AS server
WORKDIR /src
COPY . .
RUN cargo build --release -p ide-host --bin openidea-server

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates bash \
    && rm -rf /var/lib/apt/lists/*
COPY --from=server /src/target/release/openidea-server /usr/local/bin/openidea-server
COPY --from=frontend /src/dist /opt/openidea/web
ENV OPENIDEA_WEB_ROOT=/opt/openidea/web OPENIDEA_SERVER_HOME=/data
VOLUME /data
WORKDIR /workspace
EXPOSE 8080
# Mount your project at /workspace and set OPENIDEA_TOKEN to keep the URL stable.
CMD ["openidea-server", "--listen", "0.0.0.0:8080", "--project", "/workspace"]
